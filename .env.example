# Copy to `.env` for local dev, or add these in Lovable → Secrets (VITE_ prefix is required).
# Only the public key belongs in the browser — never put the EmailJS private key here.

VITE_EMAILJS_PUBLIC_KEY=your_public_key
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID_RECEIVER=your_receiver_template_id
VITE_EMAILJS_TEMPLATE_ID_SENDER=your_sender_autoreply_template_id
